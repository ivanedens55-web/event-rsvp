# Copy to .env for local development. Never commit .env.

# Postgres connection for the restricted app role (rsvp_app), NOT the owner.
# Supabase: use the Session pooler string. The username is rsvp_app.<project-ref>
DATABASE_URL=postgresql://rsvp_app.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# "development" or "production" (production turns on HSTS)
APP_ENV=development
